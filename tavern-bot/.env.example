# Copy to /opt/tavern-bot/.env (mode 600, owner tavernbot).
# Do not commit the real token. Leave DISCORD_TOKEN empty until you have one.
DISCORD_TOKEN=
# Optional. If the bot is in exactly one guild this can stay empty.
DISCORD_GUILD_ID=
# Optional comma-separated Discord user IDs. Empty = any member of that guild (including DMs from those members).
ALLOWED_USER_IDS=
